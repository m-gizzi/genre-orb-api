# Copy this file to .env and adjust values as needed

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=
# Comma-separated list of allowed OAUTH origins
ALLOWED_OAUTH_ORIGINS=
# Public origin the browser reaches the app on, when that is not the address
# Rails itself is bound to (an ngrok tunnel, say). Sets the OAuth redirect_uri;
# leave blank when the browser talks to Rails directly.
OAUTH_PUBLIC_URL=
